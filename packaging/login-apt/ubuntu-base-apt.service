[Unit]
Description=Refresh APT and upgrade installed packages at graphical sign-in
Wants=network-online.target
After=network-online.target apt-daily.service apt-daily-upgrade.service
StartLimitIntervalSec=30min
StartLimitBurst=4

[Service]
Type=oneshot
Environment=DEBIAN_FRONTEND=noninteractive
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ExecStart=/usr/bin/apt-get -o Acquire::Retries=3 --error-on=any update
ExecStart=/usr/bin/apt-get -o DPkg::Lock::Timeout=300 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold -y --no-remove --with-new-pkgs upgrade
Restart=on-failure
RestartSec=90s
TimeoutStartSec=infinity
