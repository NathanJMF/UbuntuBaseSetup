#!/bin/sh
set -eu

/usr/bin/dconf load /org/gnome/shell/extensions/dash-to-panel/ < "$1"
/usr/bin/dconf load /org/gnome/shell/extensions/arcmenu/ < "$2"

/usr/bin/python3 - <<'PY'
import os

from gi.repository import Gio, GLib

shell = Gio.Settings.new("org.gnome.shell")
extensions = ("dash-to-panel@jderose9.github.com", "arcmenu@arcmenu.com")
dock = "ubuntu-dock@ubuntu.com"

enabled = [uuid for uuid in shell.get_strv("enabled-extensions") if uuid != dock]
disabled = [uuid for uuid in shell.get_strv("disabled-extensions") if uuid not in extensions]
enabled.extend(uuid for uuid in extensions if uuid not in enabled)
if dock not in disabled:
    disabled.append(dock)

if not shell.set_strv("disabled-extensions", disabled):
    raise SystemExit("Could not set disabled GNOME extensions.")
if not shell.set_strv("enabled-extensions", enabled):
    raise SystemExit("Could not set enabled GNOME extensions.")
preferences = {
    "org.gnome.shell": {
        "favorite-apps": ("as", ["org.gnome.Nautilus.desktop", "chromium_chromium.desktop"]),
    },
    "org.gnome.desktop.interface": {
        "color-scheme": ("s", "prefer-dark"),
        "gtk-theme": ("s", "Yaru-olive-dark"),
        "icon-theme": ("s", "Yaru-olive-dark"),
        "accent-color": ("s", "green"),
        "clock-format": ("s", "24h"),
        "clock-show-seconds": ("b", True),
        "clock-show-weekday": ("b", True),
    },
    "org.gnome.desktop.peripherals.mouse": {
        "accel-profile": ("s", "flat"),
    },
    "org.gnome.desktop.peripherals.touchpad": {
        "two-finger-scrolling-enabled": ("b", True),
    },
    "org.gnome.mutter": {
        "dynamic-workspaces": ("b", False),
    },
    "org.gnome.desktop.wm.preferences": {
        "num-workspaces": ("i", 1),
    },
    "org.gnome.SessionManager": {
        "logout-prompt": ("b", False),
    },
    "org.gnome.desktop.session": {
        "idle-delay": ("u", 900),
    },
    "org.gnome.desktop.screensaver": {
        "lock-enabled": ("b", os.environ.get("UBUNTU_DESKTOP_AUTO_LOCK") == "true"),
        "lock-delay": ("u", 0),
        "ubuntu-lock-on-suspend": ("b", False),
    },
    "org.gnome.settings-daemon.plugins.power": {
        "sleep-inactive-ac-type": ("s", "nothing"),
        "sleep-inactive-battery-type": ("s", "nothing"),
        "sleep-inactive-ac-timeout": ("i", 0),
        "sleep-inactive-battery-timeout": ("i", 0),
    },
}
for schema, values in preferences.items():
    settings = Gio.Settings.new(schema)
    for key, (kind, value) in values.items():
        if not settings.set_value(key, GLib.Variant(kind, value)):
            raise SystemExit(f"Could not set {schema} {key}.")

schemas = Gio.SettingsSchemaSource.get_default()
for name in (
    "org.gnome.desktop.wm.keybindings",
    "org.gnome.mutter.keybindings",
    "org.gnome.shell.keybindings",
):
    schema = schemas.lookup(name, True)
    if schema is None:
        continue
    settings = Gio.Settings.new_full(schema, None, None)
    for key in schema.list_keys():
        if key.startswith(("switch-to-workspace", "move-to-workspace")):
            if not settings.set_strv(key, []):
                raise SystemExit(f"Could not clear {name} {key}.")

Gio.Settings.sync()
PY

templates=$(/usr/bin/xdg-user-dir TEMPLATES)
if [ -z "$templates" ] || [ "${templates%/}" = "${HOME%/}" ]; then
    templates="$HOME/Templates"
    /usr/bin/xdg-user-dirs-update --set TEMPLATES "$templates"
fi
mkdir -p -- "$templates"
# Keep an existing template, even if another process creates it first.
if [ ! -e "$templates/New File" ] && [ ! -L "$templates/New File" ]; then
    (set -C; : > "$templates/New File")
fi
