#!/bin/sh
set -eu

repository=https://github.com/NathanJMF/UbuntuResourceMonitor.git
remote_ref=$(git ls-remote --exit-code "$repository" refs/heads/main)
revision=$(printf '%s\n' "$remote_ref" | cut -f1)
data_home=${XDG_DATA_HOME:-"$HOME/.local/share"}
prefix="$data_home/ubuntu-desktop-setup/resources-$revision"

if [ ! -x "$prefix/bin/resources" ]; then
    build=$(mktemp -d)
    trap 'rm -rf -- "$build"' EXIT
    git -C "$build" init --quiet
    git -C "$build" fetch --quiet --depth 1 "$repository" "$revision"
    git -C "$build" checkout --quiet --detach "$revision"
    cp "$build/data/icons/net.nokyan.Resources.Devel.svg" "$build/data/icons/net.nokyan.Resources.svg"
    sed -i "/^cargo_options = /a cargo_options += ['--locked']" "$build/src/meson.build"
    meson setup "$build/build" "$build" --prefix "$prefix" -Dprofile=default
    meson compile -C "$build/build"
    DESTDIR="$build/staged" meson install --no-rebuild -C "$build/build"
    glib-compile-schemas "$build/staged$prefix/share/glib-2.0/schemas"
    mkdir -p -- "$(dirname "$prefix")"
    mv -T -- "$build/staged$prefix" "$prefix"
fi

/usr/bin/python3 - "$prefix" "$data_home" <<'PY'
import pathlib
import sys

prefix, data = map(pathlib.Path, sys.argv[1:])
desktop = data / "applications" / "net.nokyan.Resources.desktop"
desktop.parent.mkdir(parents=True, exist_ok=True)

def quote(value):
    special = '\\"$' + chr(96)
    return '"' + ''.join(('\\' if char in special else '') + char for char in value) + '"'

desktop.write_text(
    "[Desktop Entry]\nType=Application\nName=Resources\n"
    "Comment=Monitor system resources and processes\n"
    "Exec=/usr/bin/env "
    + quote(f"GSETTINGS_SCHEMA_DIR={prefix}/share/glib-2.0/schemas")
    + " " + quote(str(prefix / "bin/resources"))
    + "\nIcon=" + str(prefix / "share/icons/hicolor/scalable/apps/net.nokyan.Resources.svg")
    + "\nCategories=System;Monitor;\nStartupNotify=true\n"
)
PY
