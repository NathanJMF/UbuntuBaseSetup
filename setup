#!/bin/sh
set -eu

lock_screen=false
case "$#" in
    0) ;;
    1)
        case "$1" in
            --lock-after-15-minutes) lock_screen=true ;;
            --help)
                printf '%s\n' 'Usage: ./setup [--lock-after-15-minutes]'
                exit 0 ;;
            *) echo "Unknown option: $1" >&2; exit 2 ;;
        esac ;;
    *) echo "Usage: ./setup [--lock-after-15-minutes]" >&2; exit 2 ;;
esac

cd "$(dirname "$0")"
if [ "$(id -u)" -eq 0 ] || [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    echo "Run ./setup as your desktop user from a terminal in GNOME." >&2
    exit 1
fi
case "$(gnome-shell --version 2>/dev/null)" in
    "GNOME Shell 50."*) ;;
    *) echo "This profile targets GNOME Shell 50 on Ubuntu Desktop." >&2; exit 1 ;;
esac
. /etc/os-release
if [ "$ID" != ubuntu ]; then
    echo "This setup targets Ubuntu Desktop." >&2
    exit 1
fi

if [ -r /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]; then
    . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
fi
if [ -r "$HOME/.nix-profile/etc/profile.d/nix.sh" ]; then
    . "$HOME/.nix-profile/etc/profile.d/nix.sh"
fi

set -- dconf-cli python3-gi libgnome-menu-3-0 gir1.2-gmenu-3.0 \
    xdg-user-dirs yaru-theme-gtk yaru-theme-icon gnome-shell-ubuntu-extensions \
    snapd curl patch build-essential libgtk-3-bin meson ninja-build pkg-config gettext desktop-file-utils \
    libxml2-utils libgtk-4-dev libadwaita-1-dev libglib2.0-dev cargo rustc \
    iproute2 dmidecode
ubuntu_nix=false
if ! command -v nix >/dev/null 2>&1 || [ "$(readlink -f "$(command -v nix)")" = /usr/bin/nix ]; then
    ubuntu_nix=true
    set -- "$@" nix-bin nix-setup-systemd bash-static
fi
sudo apt-get update
sudo apt-get install -y "$@"
export UBUNTU_DESKTOP_AUTO_LOCK="$lock_screen"
if "$ubuntu_nix"; then
    if ! systemctl is-active --quiet nix-daemon.service &&
        ! systemctl is-active --quiet nix-daemon.socket; then
        sudo systemctl enable --now nix-daemon.service
    fi
    export NIX_REMOTE=daemon
    account=$(id -un)
    if ! id -nG "$account" | tr ' ' '\n' | grep -qx nix-users; then
        sudo usermod -aG nix-users "$account"
    fi
    if ! id -nG | tr ' ' '\n' | grep -qx nix-users; then
        exec sg nix-users -c 'exec /bin/sh ./activate-setup'
    fi
fi
exec /bin/sh ./activate-setup
