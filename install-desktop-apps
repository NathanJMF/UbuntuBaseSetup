#!/bin/sh
set -eu

if ! snap list keepassxc >/dev/null 2>&1; then
    sudo snap install keepassxc
fi
if ! snap list pycharm-community >/dev/null 2>&1; then
    sudo snap install pycharm-community --classic
fi

if [ "$(dpkg --print-architecture)" = amd64 ] &&
    [ "$(dpkg-query -W -f='${db:Status-Status}' chatgpt 2>/dev/null || true)" != installed ]; then
    if [ ! -e /etc/apt/sources.list.d/chatgpt.sources ]; then
        sudo install -m 0644 packaging/chatgpt-archive-keyring.gpg /usr/share/keyrings/chatgpt-archive-keyring.gpg
        sudo install -m 0644 packaging/chatgpt.sources /etc/apt/sources.list.d/chatgpt.sources
    fi
    sudo apt-get update
    sudo apt-get install -y chatgpt
fi

keeper_dir=${XDG_DATA_HOME:-"$HOME/.local/share"}/keeper
keeper_connect=$keeper_dir/app/keeper-connect
socket_unit=keeper-connect-$(id -u).socket

installer=
if [ ! -x "$keeper_dir/app/run-tray" ]; then
    checkout=$(mktemp -d)
    trap 'rm -rf -- "$checkout"' EXIT
    revision=${UBUNTU_KEEPER_REVISION:-cfdbfb24e1a4d2ac579944becd8611488b70ae82}
    printf '%s\n' "$revision" | grep -Eq '^[0-9a-f]{40}$' || exit 2
    git -C "$checkout" init --quiet
    git -C "$checkout" remote add origin https://github.com/NathanJMF/KeePassXCAgentAccess.git
    git -C "$checkout" fetch --quiet --depth 1 origin "$revision"
    git -C "$checkout" checkout --quiet -b main FETCH_HEAD
    git -C "$checkout" config branch.main.remote origin
    git -C "$checkout" config branch.main.merge refs/heads/main
    test "$(git -C "$checkout" rev-parse HEAD)" = "$revision"
    installer=$checkout/install
elif [ ! -x "$keeper_connect" ] || ! systemctl is-active --quiet "$socket_unit"; then
    # Use the installed release for a desktop-only installation or a socket repair.
    installer=$keeper_dir/update-source/install
    if [ ! -x "$installer" ]; then
        echo 'Keeper is installed without its update checkout. Run ./install --connect-agent from its matching trusted release, then retry setup.' >&2
        exit 1
    fi
fi
python3 packaging/keeper-launcher.py "$keeper_dir" "$installer"

if [ ! -x "$keeper_connect" ] || ! systemctl is-active --quiet "$socket_unit"; then
    echo 'Keeper setup did not bring up its local MCP connection.' >&2
    exit 1
fi

codex=/usr/lib/chatgpt/resources/codex
if [ ! -x "$codex" ]; then
    codex=$(command -v codex || true)
fi
if [ -n "$codex" ]; then
    # Query successfully before adding anything. Keep custom and disabled entries.
    servers=$("$codex" mcp list --json)
    registered=$(printf '%s' "$servers" | python3 -c 'import json, sys
print(any(server["name"] == "keeper" for server in json.load(sys.stdin)))')
    if [ "$registered" = False ]; then
        "$codex" mcp add keeper -- "$keeper_connect"
    fi
else
    printf 'Keeper MCP is ready. Use %s as the stdio command in your agent client.\n' "$keeper_connect"
fi

state=${XDG_STATE_HOME:-"$HOME/.local/state"}/ubuntu-desktop-setup
mkdir -p "$state"
if revision=$(git -C "$keeper_dir/update-source" rev-parse HEAD); then
    printf '%s\n' "$revision" > "$state/keeper-revision"
else
    rm -f -- "$state/keeper-revision"
fi
