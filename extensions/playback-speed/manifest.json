{
  "manifest_version": 3,
  "name": "Video Playback Speed",
  "version": "0.6.1",
  "description": "Set one playback speed for videos across your tabs.",
  "permissions": [
    "storage",
    "downloads",
    "contextMenus"
  ],
  "action": {
    "default_title": "Video Playback Speed",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/playback-16.png",
      "32": "icons/playback-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "remember-speed.js",
        "video-menu.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "css": [
        "video-menu.css"
      ]
    }
  ],
  "icons": {
    "16": "icons/playback-16.png",
    "32": "icons/playback-32.png",
    "48": "icons/playback-48.png",
    "128": "icons/playback-128.png"
  }
}
